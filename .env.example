# 问道 环境变量

# 必填：LLM 网关密钥（服务端使用，绝不暴露给前端；对话 + TTS 共用）
LLM_API_KEY=

# LLM 网关根地址（小米 MiMo 网关）
#   对话走 ${LLM_BASE}/anthropic（Anthropic 兼容）
#   语音走 ${LLM_BASE}/v1/chat/completions（TTS 模型）
LLM_BASE=https://token-plan-cn.xiaomimimo.com

# 对话模型：打字/深度模式（pro 更会思考）
WENDAO_MODEL=mimo-v2.5-pro
# 语音/通话模式（v2.5 首句延迟砍半、解码快 3.7x，短口语质量不掉）
WENDAO_MODEL_FAST=mimo-v2.5

# 单次回复最大 token（含模型思考，留足余量；可见回答由提示词约束为短）
WENDAO_MAX_TOKENS=1024

# 语音合成模型 + 音色（预置音色：苏打/白桦 男，冰糖/茉莉 女，Mia/Chloe/Milo/Dean 英文）
WENDAO_TTS_MODEL=mimo-v2.5-tts
WENDAO_TTS_VOICE=苏打

# 可选：以子路径部署时设置，如 /wendao
# BASE_PATH=/wendao

# 账号 + 云端会话历史（接深脑自托管 Supabase）
# anon key 公开设计（受 RLS 保护），会打进前端；service key 仅服务端
NEXT_PUBLIC_SUPABASE_URL=https://sb.ai.zaowuyun.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
