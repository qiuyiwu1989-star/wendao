{
  "name": "@qiuyiwu1989-star/voice",
  "version": "1.0.0",
  "description": "语音交互能力模组：录音+静音检测、句级流式朗读、完整通话状态机。从「问道」抽出，含小米 MiMo 服务端代理。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qiuyiwu1989-star/wendao.git",
    "directory": "packages/voice"
  },
  "keywords": ["voice", "asr", "tts", "speech", "mimo", "realtime", "react"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./server/mimo": { "types": "./dist/server/mimo.d.ts", "default": "./dist/server/mimo.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": { "react": ">=18" },
  "devDependencies": { "typescript": "^5.5.3", "@types/react": "^18.3.3", "@types/node": "^20.14.0" },
  "publishConfig": { "registry": "https://npm.pkg.github.com" },
  "sideEffects": false
}
